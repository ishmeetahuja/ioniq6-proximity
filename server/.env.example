# ---- copy to .env and fill in -------------------------------------------------

# Public hostname. No domain? Use your static IP with dashes + .sslip.io, e.g. 15-222-1-23.sslip.io
DOMAIN=car.example.com
PUBLIC_URL=https://car.example.com

# BlueLink Canada account
BLUELINK_USERNAME=you@example.com
BLUELINK_PASSWORD=
BLUELINK_PIN=
# BLUELINK_VIN=            # only if the account has more than one car

# API tokens — generate each with:  openssl rand -hex 24
# ADMIN_TOKEN can do everything. PHONE_TOKEN (for phone automations) can only read status,
# LOCK, and drive auto-lock — it can never unlock or start the car.
ADMIN_TOKEN=
PHONE_TOKEN=

# ---- walk-away auto-lock --------------------------------------------------------
AUTOLOCK_ENABLED=true
AUTOLOCK_GRACE_SECONDS=20      # wait after "away" before locking (your window to tap Cancel)
AUTOLOCK_CHECK_FIRST=false     # false: lock straight away, inspect only if it fails (fastest)
                               # true: wake the car and check first (+10–30 s, but never sends a
                               #       redundant lock to an already-locked car)
AUTOLOCK_RETRY_SECONDS=30      # if a door/trunk is open, re-check this often…
AUTOLOCK_MAX_ATTEMPTS=5        # …this many times, then send a high-priority alert

# Safety net: check the (cached) status; if the car is off and unlocked on two checks in a row,
# lock it. Every GUARD_INTERVAL_MINUTES for GUARD_ACTIVE_HOURS after the car was used (drive, park,
# command), every GUARD_IDLE_MINUTES otherwise, and not at all once a lock is confirmed. Each check
# usually means a fresh Hyundai sign-in (they last ~30 min), and Cloudflare limits sign-ins hard.
GUARD_INTERVAL_MINUTES=30      # 0 = off
# GUARD_ACTIVE_HOURS=3
# GUARD_IDLE_MINUTES=360

# ---- going easy on Hyundai --------------------------------------------------------
# Waking the car (live status, commands, location) is what Hyundai limits per day. These only
# govern the app's AUTOMATIC "this looks out of date" refreshes; your own taps and every lock
# always go through.
# STATUS_CACHE_SECONDS=300          # app opens within 5 min share one read of Hyundai's saved copy
# AUTO_REFRESH_DAILY_MAX=4          # automatic car wake-ups per 24 h
# AUTO_REFRESH_MIN_GAP_MINUTES=120  # …at least this far apart
# CAR_WAKE_DAILY_SOFT_MAX=12        # once this many wake-ups (of any kind) in 24 h, automatic ones stop
# AUTO_REFRESH_QUIET_FROM_HOUR=22   # no automatic wake-ups overnight (local time)
# AUTO_REFRESH_QUIET_TO_HOUR=6

# ---- notifications (either or both) ----------------------------------------------
# ntfy: install the ntfy app, subscribe to a long random topic name, put the full URL here.
NTFY_URL=https://ntfy.sh/ioniq6-change-this-to-something-random
# NTFY_TOKEN=                  # only for a protected/self-hosted ntfy server
# Telegram (e.g. your existing bot):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
